# ── Ketamine.cc licensing server ──────────────────────────────────────────────
# Copy to .env and fill in. Generate secrets with:
#   node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('hex'))"

PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# API origin (Render custom domain)
PUBLIC_BASE_URL=https://api.ketaminecc.website
# Static frontend origin (GitHub Pages)
PUBLIC_SITE_URL=https://ketaminecc.website
# Must list the exact scheme + host the browser uses. Keep the http:// entries
# while the Pages custom-domain certificate is still pending; remove them once
# HTTPS is enforced.
CORS_ORIGINS=https://ketaminecc.website,https://www.ketaminecc.website,http://ketaminecc.website,http://www.ketaminecc.website
COOKIE_SAME_SITE=lax

SESSION_SECRET=
ENC_KEY=
BOT_SHARED_SECRET=

ADMIN_SECRET=

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
DEMO_MODE=false

DISCORD_PURCHASE_WEBHOOK_URL=
SUPPORT_EMAIL=support@ketaminecc.site
