# /etc/caddy/Caddyfile
# GoDaddy DNS points ketaminecc.website at this server's public IPv4.
# Caddy obtains and renews the Let's Encrypt certificate automatically.
# No Cloudflare involved.

ketaminecc.website, www.ketaminecc.website {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
